# Copy to .env.local (web: apps/web/.env.local) and fill in. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ / EXPO_PUBLIC_ are exposed to the browser/app; everything
# else is server-only.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (spec §7) -----------------------------------------------------
# Local values are printed by `pnpm db:start` (supabase start).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: bypasses RLS. Used by route handlers (webhooks, device registration, admin).
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in, read by supabase/config.toml for local auth.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Payments: Razorpay Subscriptions (M4) ----------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Video: provider behind VideoProvider (M3) ------------------------------
# "bunny" in production. "dev" stores uploads under apps/web/.dev-videos with no DRM,
# for local testing only (refused in production).
VIDEO_PROVIDER=dev
# Bunny Stream → Video library → API:
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Library → Security → "Embed view token authentication" key:
BUNNY_STREAM_TOKEN_SECURITY_KEY=
# Library → API → CDN hostname (for thumbnails), e.g. vz-abc123.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
# Random secret; webhook URL is https://<domain>/api/webhooks/bunny?token=<this>
BUNNY_WEBHOOK_SECRET=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Modulr <hello@example.com>"

# --- Analytics / errors (M7) ------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Android app (M6) ---------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SITE_URL=

# --- AI doubt solver (Phase 3) ------------------------------------------------
# LLM_API_KEY=
